// SPDX-License-Identifier: BSL-1.0

.{
    .name = .fluxion_gl,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x582be8e9e208d017,
    .dependencies = .{
        // The library's one dependency.
        .fluxion_dyn = .{
            .url = "git+https://github.com/kisstp2006/fluxion-dyn#78c8c2a2ddcad8e90d3b45c0f80023f0b479f26b",
            .hash = "fluxion_dyn-0.1.0-5Dy8EU9PAQAp7cuNi6RU8eu0pgcFXWUbrBq69b7idVnA",
        },

        // What the examples draw with. Lazy: fetched only when the examples
        // are built, which is when this is the root package or `-Dexamples`
        // is given. A program that depends on `fluxion_gl` never downloads
        // either, and the module itself imports neither - a loader has no
        // business opening windows or having opinions about vectors.
        .fluxion_platform = .{
            .url = "git+https://github.com/kisstp2006/fluxion-platform#a3f3707277d8a4fdc8100a6edd85bc779284de52",
            .hash = "fluxion_platform-0.1.0-WsOjUUdvFwCsEYeB1XX5RhTBrRB3ElWncnw7VZ6cR99F",
            .lazy = true,
        },
        .fluxion_math = .{
            .url = "git+https://github.com/kisstp2006/fluxion-math#92afdbddbf930369265d24136402c7eb5dd8f70e",
            .hash = "fluxion_math-0.1.0-dfpZBeNUBAAwUMriLKaOTRBWGFmfY53_jyYuMUxkPYek",
            .lazy = true,
        },
        // And what `--capture` saves a frame with.
        .fluxion_image = .{
            .url = "git+https://github.com/kisstp2006/fluxion-image#79463ef201f11e15ada014467c0ad1d58b2a882d",
            .hash = "fluxion_image-0.1.0-fyJkdS7vAAB1p43VSutvpxQB32hIcvJb3fGSZbo_qeha",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "examples",
        "README.md",
    },
}
